---
import site from '../data/site.json';
import { url } from '../lib/url';

const socials = [
  { href: site.facebook, label: 'Facebook', icon: url('/icons/facebook.png') },
  { href: site.instagram, label: 'Instagram', icon: url('/icons/instagram.png') },
  { href: site.whatsapp, label: 'WhatsApp-kanaal', icon: url('/icons/whatsapp.png') },
].filter((social) => social.href);
---

<footer class="mt-16 flex flex-col items-center gap-4">
  <ul class="flex items-center gap-4">
    {
      socials.map(({ href, label, icon }) => (
        <li>
          <a href={href} aria-label={label} rel="noopener">
            <img src={icon} alt="" width="32" height="32" />
          </a>
        </li>
      ))
    }
  </ul>
</footer>
