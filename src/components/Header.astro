---
import site from '../data/site.json';
import Logo from '../assets/images/dogma-logo.svg';
import { url } from '../lib/url';

const links = [
  { href: url('/'), label: 'home' },
  { href: url('/agenda/'), label: 'agenda' },
  { href: url('/spelers/'), label: 'spelers' },
  { href: url('/contact/'), label: 'contact' },
];

const current = Astro.url.pathname;
---

<header class="pt-6">
  <nav aria-label="Hoofdmenu">
    <ul class="flex flex-wrap justify-center gap-x-6 gap-y-2 text-lg font-bold tracking-widest">
      {
        links.map(({ href, label }) => (
          <li>
            <a
              href={href}
              class:list={[
                'text-ink no-underline decoration-2 underline-offset-4 hover:underline',
                current === href && 'underline',
              ]}
              aria-current={current === href ? 'page' : undefined}
            >
              {label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <a href={url('/')} class="mt-12 block">
    <Logo role="img" aria-label={site.name} class="block h-auto w-full" />
  </a>
</header>
