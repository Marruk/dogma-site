---
import site from '../data/site.json';
import Logo from '../assets/images/dogma-logo.svg';

interface Props {
  /** Pages with a hero show the logo there instead. */
  logo?: boolean;
}

const { logo = true } = Astro.props;

const links = [
  { href: '/', label: 'home' },
  { href: '/agenda/', label: 'agenda' },
  { href: '/spelers/', label: 'spelers' },
  { href: '/contact/', label: 'contact' },
];

const current = Astro.url.pathname;
---

<header class="pt-6">
  <nav aria-label="Hoofdmenu">
    <ul class="flex flex-wrap justify-center gap-x-6 gap-y-2 text-lg font-bold tracking-widest">
      {
        links.map(({ href, label }) => (
          <li>
            <a
              href={href}
              class:list={[
                'text-ink no-underline hover:underline',
                current === href && 'underline decoration-2 underline-offset-4',
              ]}
              aria-current={current === href ? 'page' : undefined}
            >
              {label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  {
    logo && (
      <a href="/" class="mt-6 block">
        {/* Shares its view-transition-name with the hero logo, so it morphs between pages. */}
        <Logo role="img" aria-label={site.name} class="block h-auto w-full [view-transition-name:logo]" />
      </a>
    )
  }
</header>
